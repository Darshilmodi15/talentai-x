# Required AI provider credential
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Database connection components (the backend builds DATABASE_URL values)
DATABASE_URL=
DATABASE_URL_SYNC=
DATABASE_USER=talentai
DATABASE_PASSWORD=talentai_secret
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=talentai_db

REDIS_URL=redis://localhost:6379/0
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=talentai_db
CHROMA_HOST=localhost
CHROMA_PORT=8001

SECRET_KEY=replace_with_a_long_random_secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=replace_with_supabase_jwt_secret
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key_for_demo_setup_only
# Private team demo credentials. Never expose these as VITE_* variables.
DEMO_INDIVIDUAL_EMAIL=demo.individual@example.com
DEMO_INDIVIDUAL_PASSWORD=replace_with_a_strong_demo_password
DEMO_RECRUITER_EMAIL=demo.recruiter@example.com
DEMO_RECRUITER_PASSWORD=replace_with_a_strong_demo_password
ALLOW_DEV_API_KEY=false

ENVIRONMENT=development
DEBUG=true
MAX_UPLOAD_SIZE_MB=10
INDIVIDUAL_UPLOAD_LIMIT=3
RECRUITER_UPLOAD_LIMIT=25
UPLOAD_LIMIT_WINDOW_HOURS=24
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_ORIGIN_REGEX=https://.*|http://localhost:\d+|http://127\.0\.0\.1:\d+
RATE_LIMIT_PER_MINUTE=100

GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACKS=["gemini-2.5-flash-lite","gemini-2.0-flash","gemini-1.5-flash"]
EMBEDDING_MODEL=gemini-embedding-001
MATCH_THRESHOLD_AUTO=0.85
MATCH_THRESHOLD_REVIEW=0.60

VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
