# Required AI provider credential
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Database connection components (the backend builds DATABASE_URL values)
DATABASE_URL=
DATABASE_URL_SYNC=
DATABASE_USER=talentai
DATABASE_PASSWORD=talentai_secret
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=talentai_db

REDIS_URL=redis://localhost:6379/0
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=talentai_db
CHROMA_HOST=localhost
CHROMA_PORT=8001

SECRET_KEY=replace_with_a_long_random_secret
API_KEY_HEADER=X-API-Key
VITE_API_KEY=dev_key_change_in_production

ENVIRONMENT=development
DEBUG=true
MAX_UPLOAD_SIZE_MB=10
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_ORIGIN_REGEX=https://.*|http://localhost:\d+|http://127\.0\.0\.1:\d+
RATE_LIMIT_PER_MINUTE=100

GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/embedding-001
MATCH_THRESHOLD_AUTO=0.85
MATCH_THRESHOLD_REVIEW=0.60

VITE_API_URL=http://localhost:8000
